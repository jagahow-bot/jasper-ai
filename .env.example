# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8001
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=6144
# Moonshot Kimi K3 provider for high-value reasoning tasks (narrate, overlay, candidate summary, compare)
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
# K3 reasoning effort: max (only value currently supported by K3); omit to use default.
# MOONSHOT_REASONING_EFFORT=max
# Prose-heavy routes (narrate, compare, candidate summary); default 8192
# GEMINI_NARRATIVE_MAX_OUTPUT_TOKENS=8192
# Pro round seed output budget (default 14336, max 16384). On Gemini, thinking tokens count
# toward maxOutputTokens — raise this when GEMINI_THINKING_LEVEL is not off (e.g. low).
# GEMINI_ROUND_SEED_MAX_OUTPUT_TOKENS=14336
# Optional round-seed-only thinking override; unset inherits GEMINI_THINKING_LEVEL below.
# GEMINI_ROUND_SEED_THINKING_LEVEL=low
# ultra | standard | full | auto (auto picks from GEMINI_MAX_OUTPUT_TOKENS + champion_research)
GEMINI_LEARNING_CONTEXT_MODE=auto
# off | minimal | low | medium | high (default off)
# When not off: standard param seeds + Pro round seed use this (non-full → minimal; full → low or GEMINI_THINKING_LEVEL_FULL)
# GEMINI_THINKING_LEVEL=low

# Backend (apps/api)
API_CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=6144
# Moonshot Kimi K3 provider for high-value reasoning tasks (narrate, overlay, candidate summary, compare)
MOONSHOT_API_KEY=
AI_REASONING_MODEL=kimi-k3
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
GEMINI_PARAM_SEED_MAX_RETRIES=3
# Standard Optuna only: when trials > AI_PARAM_SEED_BATCH_THRESHOLD (default 10), cap at AI_PARAM_SEED_MAX_COUNT (default 8) batched param seeds; extra trials are sampler-only. Pro convergence ignores these — one generate_ai_round_seed call per refinement round.
# AI_PARAM_SEED_BATCH_THRESHOLD=10
# AI_PARAM_SEED_MAX_COUNT=8
# AI_PARAM_SEED_BATCH_SIZE=8
# Pro round seed (14336 default; thinking tokens share this budget on Gemini)
# GEMINI_ROUND_SEED_MAX_OUTPUT_TOKENS=14336
# GEMINI_ROUND_SEED_THINKING_LEVEL=   # unset = inherit GEMINI_THINKING_LEVEL
# ultra | standard | full | auto (auto picks from GEMINI_MAX_OUTPUT_TOKENS + champion_research)
GEMINI_LEARNING_CONTEXT_MODE=auto
# off | minimal | low | medium | high (default off)
# When not off: standard param seeds + Pro round seed use this (non-full → minimal; full → low or GEMINI_THINKING_LEVEL_FULL)
# GEMINI_THINKING_LEVEL=low
# Optional override when learning context resolves to full (default low)
# GEMINI_THINKING_LEVEL_FULL=low

# Email notifications (optional): when SMTP_HOST is set, completed/failed jobs
# that include notify_email in the request trigger a best-effort notification.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxx
# SMTP_FROM=notifications@your-verified-domain.com
# SMTP_STARTTLS=true
# SMTP_SSL=false
# PUBLIC_WEB_URL=http://localhost:3000

# Regime detector (backend): drawdown recovery fraction to accelerate risk_off exit (0–1, default 0.35)
# REGIME_RECOVERY_DRAWDOWN_PCT=0.35
