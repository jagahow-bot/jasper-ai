# Copy to .env.production on your server (never commit real secrets).
# Used by: docker compose -f docker-compose.prod.yml

# --- Public site (browser / SSR) ---
# Leave empty on VPS: browser calls same-origin /quant-api via Next.js proxy.
# For split deploy (Vercel + Railway): set to your public API URL, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=

# Next.js server-side proxy to FastAPI (docker-compose sets this automatically)
# QUANT_API_URL=http://api:8001

# Gemini (required for AI narratives / Pro seeds)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_ROUND_SEED_MAX_OUTPUT_TOKENS=8192
GEMINI_LEARNING_CONTEXT_MODE=auto
GEMINI_PARAM_SEED_MAX_RETRIES=3
# GEMINI_THINKING_LEVEL=low
# GEMINI_ROUND_SEED_THINKING_LEVEL=   # unset = inherit GEMINI_THINKING_LEVEL

# FastAPI CORS — comma-separated origins allowed to call API directly.
# VPS (proxy only): http://localhost or your domain is enough.
# Split deploy: https://your-app.vercel.app,https://your-custom-domain.com
API_CORS_ORIGINS=https://your-domain.com,http://localhost

# Docker compose host port for nginx (default 80)
HTTP_PORT=80
